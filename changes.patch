+void FastShareTextCopy(
+		std::shared_ptr<Main::SessionShow> show,
+		TextWithTags text) {
+	const auto box = std::make_shared<base::weak_qptr<Ui::BoxContent>>();
+	const auto sending = std::make_shared<bool>();
+	const auto self = show->session().data().history(show->session().user());
+	const auto countMessages = [=](const TextWithTags &comment) {
+		return ComputeSendingMessagesCount(self, { .text = &comment });
+	};
+	const auto submit = [=](
+			std::vector<not_null<Data::Thread*>> &&threads,
+			Fn<bool()> checkPaid,
+			TextWithTags &&comment,
+			Api::SendOptions options,
+			Data::ForwardOptions) {
+		if (*sending
+			|| !*box
+			|| threads.empty()
+			|| comment.text.trimmed().isEmpty()) {
+			return;
+		}
+		const auto error = GetErrorForSending(threads, {
+			.text = &comment,
+		});
+		if (error.error) {
+			(*box)->getDelegate()->show(
+				MakeSendErrorBox(error, threads.size() > 1));
+			return;
+		} else if (!checkPaid()) {
+			return;
+		}
+		*sending = true;
+		auto &api = show->session().api();
+		for (const auto &thread : threads) {
+			auto message = Api::MessageToSend(Api::SendAction(thread, options));
+			message.textWithTags = comment;
+			message.action.clearDraft = false;
+			api.sendMessage(std::move(message));
+		}
+		if (*box) {
+			(*box)->closeBox();
+		}
+	};
+	*box = show->show(Box<ShareBox>(ShareBox::Descriptor{
+		.session = &show->session(),
+		.countMessagesCallback = countMessages,
+		.submitCallback = submit,
+		.filterCallback = [](not_null<Data::Thread*> thread) {
+			return Data::CanSendTexts(thread);
+		},
+		.titleOverride = tr::lng_context_send_text_copy(),
+		.moneyRestrictionError = ShareMessageMoneyRestrictionError(),
+		.initialText = std::move(text),
+	}));
+}
