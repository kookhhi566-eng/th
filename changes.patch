+void AddCopyTextQuoteAction(
+		not_null<Ui::PopupMenu*> menu,
+		not_null<HistoryItem*> item,
+		Fn<bool(not_null<HistoryItem*>)> allowed) {
+	if (item->originalText().empty()) {
+		return;
+	}
+	const auto owner = &item->history()->owner();
+	const auto id = item->fullId();
+	menu->addAction(tr::lng_hooktelegram_copy_quote(tr::now), [=] {
+		if (const auto current = owner->message(id); current && allowed(current)) {
+			auto text = current->originalText().text;
+			if (!text.isEmpty()) {
+				text.replace('\n', u"\n> "_q);
+				QGuiApplication::clipboard()->setText(u"> "_q + text);
+			}
+		}
+	}, &st::menuIconCopy);
+}
+
+void AddProtectedChatTextActions(
+		not_null<Ui::PopupMenu*> menu,
+		not_null<HistoryItem*> item,
+		not_null<Window::SessionController*> controller) {
+	const auto canCopy = [](not_null<HistoryItem*> item) {
+		const auto peer = item->history()->peer;
+		const auto media = item->media();
+		return (peer->isChat() || peer->isChannel())
+			&& (!peer->allowsForwarding() || item->forbidsForward())
+			&& item->isRegular()
+			&& !item->isService()
+			&& !IsAnchoredEphemeral(item)
+			&& item->paidType() == PaidPostType::None
+			&& (!media || (!media->ttlSeconds() && !media->invoice()))
+			&& !item->originalText().empty();
+	};
+	if (!canCopy(item)) {
+		return;
+	}
+	const auto owner = &item->history()->owner();
+	const auto id = item->fullId();
+	menu->addAction(tr::lng_context_copy_text(tr::now), [=] {
+		if (const auto current = owner->message(id);
+				current && canCopy(current)) {
+			TextUtilities::SetClipboardText(TextForMimeData::WithExpandedLinks(
+				current->originalText()));
+		}
+	}, &st::menuIconCopy);
+	AddCopyTextQuoteAction(menu, item, canCopy);
+	menu->addAction(tr::lng_context_send_text_copy(tr::now), [=] {
+		if (const auto current = owner->message(id);
+				current && canCopy(current)) {
+			const auto &text = current->originalText();
+			FastShareTextCopy(controller->uiShow(), {
+				text.text,
+				TextUtilities::ConvertEntitiesToTextTags(text.entities),
+			});
+		}
+	}, &st::menuIconForward);
+}
