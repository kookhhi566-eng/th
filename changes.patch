 namespace Intro {
 namespace details {
+namespace {
+
+constexpr auto kPasscodeOfferShown = "hooktelegram.passcodeOfferShown";
+
+void FirstLaunchPasscodeBox(not_null<Ui::GenericBox*> box) {
+	using namespace Settings::CloudPassword;
+	box->setWidth(st::boxWideWidth);
+	const auto fields = SetupPasswordFields(box->verticalLayout(), {
+		.lottie = u"local_passcode_enter"_q,
+		.title = tr::lng_passcode_create_title(),
+		.about = tr::lng_passcode_about(),
+		.placeholder = tr::lng_passcode_enter_new(),
+	});
+	const auto busy = box->lifetime().make_state<bool>(false);
+	const auto submit = [=] {
+		if (*busy) {
+			return;
+		}
+		const auto password = ValidatePasswordFields(fields);
+		if (!password) {
+			return;
+		}
+		auto &local = Core::App().domain().local();
+		if (local.hasPasscode()) {
+			box->closeBox();
+			return;
+		}
+		*busy = true;
+		fields.input->setDisabled(true);
+		fields.confirm->setDisabled(true);
+		auto utf8 = password->toUtf8();
+		auto job = local.prepareNewWrap(utf8);
+		OPENSSL_cleanse(utf8.data(), utf8.size());
+		Storage::DeriveOnWorker(
+			std::move(job),
+			crl::guard(box, [=](Storage::PasscodeDerivation &&derived) {
+				auto &app = Core::App();
+				const auto result = app.domain().local().setPasscode(
+					std::move(derived),
+					Storage::PasscodeVerification());
+				if (result == Storage::SetPasscodeResult::Success) {
+					box->closeBox();
+					app.localPasscodeChanged();
+					return;
+				}
+				*busy = false;
+				fields.input->setDisabled(false);
+				fields.confirm->setDisabled(false);
+				fields.error->setText(Lang::Hard::SecureSaveError());
+				fields.error->show();
+				FocusPasswordFields(fields);
+			}));
+	};
+	SubmitPasswordFields(fields, submit);
+	box->addButton(tr::lng_passcode_create_button(), submit);
+	box->addButton(tr::lng_cancel(), [=] { box->closeBox(); });
+	box->setFocusCallback([=] { FocusPasswordFields(fields); });
+}
